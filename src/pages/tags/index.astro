---
import Base from "../../layouts/Base.astro";
import { getPosts, tagCounts } from "../../utils/posts";
const tags = tagCounts(await getPosts());
---

<Base title="Tags" description="Browse posts by tag.">
  <div class="col">
    <h1 class="page-title">Tags</h1>
    <p class="page-lede">Browse posts by topic.</p>
    {tags.length === 0 ? <p>No tags yet. Add <code>tags: ["example"]</code> to a post.</p> : (
      <ul class="tags">
        {tags.map((t) => <li><a href={`/tags/${t.slug}/`}>{t.tag}<span class="n">{t.count}</span></a></li>)}
      </ul>
    )}
  </div>
</Base>
