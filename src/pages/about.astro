---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
---

<Base title="About" description={`About ${SITE.author}`}>
  <div class="col">
    <h1 class="page-title">About</h1>
    <div class="prose" style="font-size: 1.125rem; margin-top: 1.5rem;">
      <p>
        This is a short page about you. Edit <code>src/pages/about.astro</code> to say who you are, what you write about,
        and how readers can reach you.
      </p>
      <p>You can also write to <a href="mailto:you@example.com">you@example.com</a>.</p>
    </div>
  </div>
</Base>
