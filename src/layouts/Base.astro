---
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/newsreader/600.css";
import "@fontsource/newsreader/700.css";
import "../styles/global.css";
import { SITE } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  reading?: boolean; // show reading controls (post pages)
  noindex?: boolean;
  image?: string; // path to a social preview image
}
const { title, description = SITE.description, type = "website", reading = false, noindex = false, image } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogPath = image ?? (SITE.features.ogImages ? "/og/default.png" : undefined);
const ogUrl = ogPath ? new URL(ogPath, Astro.site).href : undefined;
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? "summary_large_image" : "summary"} />
    <slot name="head" />

    <!-- Runs before first paint so theme and reading preferences never flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem("theme");
          if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          d.dataset.theme = t;
          var r = JSON.parse(localStorage.getItem("reading") || "{}");
          if (r.size) d.dataset.size = r.size;
          if (r.width) d.dataset.width = r.width;
          if (r.font) d.dataset.font = r.font;
        } catch (e) {
          if (matchMedia("(prefers-color-scheme: dark)").matches) d.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    {reading && <div class="inkline" aria-hidden="true"></div>}
    <a class="skip" href="#main">Skip to content</a>
    <Header reading={reading} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
