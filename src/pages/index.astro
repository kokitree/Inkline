---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { SITE } from "../config";
import { getPosts, formatDate, readingTime } from "../utils/posts";

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured).slice(0, SITE.postsOnHome);
---

<Base>
  {featured ? (
    <Fragment>
    <section class="col intro featured">
      <h1><a href={`/posts/${featured.id}/`}>{featured.data.title}</a></h1>
      <p>{featured.data.description}</p>
      <div class="meta">
        <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate, SITE.lang)}</time>
        <span>{readingTime(featured.body)} min read</span>
      </div>
    </section>
    {rest.length > 0 && (
      <section class="col">
        <h2 class="section-title">Latest</h2>
        <PostList posts={rest} />
        <p class="more"><a href="/posts">All posts</a></p>
      </section>
    )}
    </Fragment>
  ) : (
    <section class="col intro">
      <h1 class="page-title">Nothing here yet</h1>
      <p class="page-lede">Add a Markdown file to <code>src/content/posts/</code> and it will appear here.</p>
    </section>
  )}
</Base>
