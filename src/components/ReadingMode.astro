---
// Reading mode: font size, width and typeface. Preferences persist in localStorage.
---

<button class="icon-btn" type="button" popovertarget="reading-panel" aria-label="Reading settings" style="font-family: var(--font-serif); font-weight: 600;">Aa</button>

<div id="reading-panel" popover role="dialog" aria-label="Reading settings">
  <div class="rp-row">
    <p class="rp-label">Text size</p>
    <div class="seg">
      <button type="button" data-size-step="-1" aria-label="Smaller text">A&minus;</button>
      <button type="button" data-size-step="1" aria-label="Larger text">A+</button>
    </div>
  </div>
  <div class="rp-row">
    <p class="rp-label">Width</p>
    <div class="seg" data-group="width">
      <button type="button" data-value="narrow">Narrow</button>
      <button type="button" data-value="medium">Medium</button>
      <button type="button" data-value="wide">Wide</button>
    </div>
  </div>
  <div class="rp-row">
    <p class="rp-label">Typeface</p>
    <div class="seg" data-group="font">
      <button type="button" data-value="serif">Serif</button>
      <button type="button" data-value="sans">Sans</button>
    </div>
  </div>
  <button class="rp-reset" type="button" data-reset>Reset to defaults</button>
</div>

<script>
  const root = document.documentElement;
  const panel = document.getElementById("reading-panel")!;
  const DEFAULTS = { size: "2", width: "medium", font: "serif" };
  type Prefs = typeof DEFAULTS;

  function load(): Prefs {
    try { return { ...DEFAULTS, ...JSON.parse(localStorage.getItem("reading") || "{}") }; }
    catch { return { ...DEFAULTS }; }
  }
  let prefs = load();

  function apply() {
    root.dataset.size = prefs.size;
    root.dataset.width = prefs.width;
    root.dataset.font = prefs.font;
    panel.querySelectorAll<HTMLElement>("[data-group]").forEach((g) => {
      const key = g.dataset.group as "width" | "font";
      g.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.value === prefs[key])));
    });
    panel.querySelector<HTMLButtonElement>('[data-size-step="-1"]')!.disabled = prefs.size === "1";
    panel.querySelector<HTMLButtonElement>('[data-size-step="1"]')!.disabled = prefs.size === "5";
  }
  function save() {
    try { localStorage.setItem("reading", JSON.stringify(prefs)); } catch {}
    apply();
  }

  panel.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest("button");
    if (!el) return;
    if (el.dataset.sizeStep) {
      prefs.size = String(Math.min(5, Math.max(1, Number(prefs.size) + Number(el.dataset.sizeStep))));
      save();
    } else if (el.dataset.value) {
      const key = (el.closest("[data-group]") as HTMLElement).dataset.group as "width" | "font";
      prefs[key] = el.dataset.value;
      save();
    } else if (el.hasAttribute("data-reset")) {
      prefs = { ...DEFAULTS };
      try { localStorage.removeItem("reading"); } catch {}
      apply();
    }
  });
  apply();
</script>
