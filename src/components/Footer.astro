---
import { SITE } from "../config";
---

<footer class="site-footer">
  <div class="frame">
    <span>
      &copy; {new Date().getFullYear()} {SITE.author} &middot;
      <a href="https://kokitree.com">kokitree.com</a>
    </span>
    {SITE.social.length > 0 && (
      <ul>{SITE.social.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    )}
  </div>
</footer>
