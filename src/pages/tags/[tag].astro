---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, tagCounts, slugify } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === slug)) },
  }));
}
const { tag, posts } = Astro.props;
---

<Base title={`Tagged: ${tag}`} description={`Posts tagged ${tag}.`}>
  <div class="col">
    <h1 class="page-title">{tag}</h1>
    <p class="page-lede">{posts.length} {posts.length === 1 ? "post" : "posts"}. <a href="/tags">All tags</a></p>
    <PostList posts={posts} />
  </div>
</Base>
