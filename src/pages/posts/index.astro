---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../utils/posts";

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))];
---

<Base title="Posts" description="Every post, newest first.">
  <div class="col">
    <h1 class="page-title">Posts</h1>
    <p class="page-lede">{posts.length} {posts.length === 1 ? "post" : "posts"}, newest first.</p>
    {years.map((y) => (
      <Fragment>
      <h2 class="year">{y}</h2>
      <PostList posts={posts.filter((p) => p.data.pubDate.getUTCFullYear() === y)} />
      </Fragment>
    ))}
  </div>
</Base>
